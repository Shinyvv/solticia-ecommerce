generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  nombre      String
  slug        String   @unique
  descripcion String
  precio      Int
  categoria   String
  imagenes    String[]
  tallas      String[]
  disponible  Boolean  @default(true)
  visible     Boolean  @default(true)
  destacado   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Category {
  id     String @id @default(cuid())
  nombre String
  slug   String @unique
}
